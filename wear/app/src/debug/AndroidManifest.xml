<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!--
            Debug builds only: tools to try the app from adb. Whoever starts them needs the DUMP permission, which the adb
            shell has and an ordinary app has not.
            StressService puts the connection under the strain of a screen of covers being left;
            DebugUpdateReceiver feeds an APK through the receiver that takes in an update from the phone.
        -->
        <service
            android:name="com.selfhosthub.wear.debug.StressService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name="com.selfhosthub.wear.debug.DebugUpdateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
