  "expo": {
    "autolinking": {
      "_comment": "expo-audio ships as a precompiled AAR by default, which would ignore our patched Android sources in patches/expo-audio (they restore the MediaSession next/previous commands needed for Samsung Now Bar). Forcing it to build from source makes the patch take effect.",
      "buildFromSource": [
        "expo-audio"
      ]
    }
  },
