<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      "SelfHost Hub" in the share sheet of other apps, for files (and text, which becomes a note). It opens the
      app's own activity; the module reads what was sent (SelfHostNative.consumeSharedContent) and the app
      asks where to put it. Nothing is sent to the server without that answer.
    -->
    <activity-alias
      android:name="expo.modules.selfhostnative.ShareTarget"
      android:targetActivity="${applicationId}.MainActivity"
      android:exported="true"
      android:label="SelfHost Hub">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity-alias>

    <!--
      What the watch sends over the Wear OS data layer (requests for the state of the players, commands): messages
      addressed to this app, handed to its JavaScript, which is the only thing that talks to the PC (see WatchLinkService).
    -->
    <service
      android:name="expo.modules.selfhostnative.WatchLinkService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:host="*"
          android:pathPrefix="/selfhost/link"
          android:scheme="wear" />
      </intent-filter>
      <!-- What the watch says about an update of its app (see services/watchUpdate.ts). -->
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:host="*"
          android:pathPrefix="/selfhost/update"
          android:scheme="wear" />
      </intent-filter>
    </service>

    <!-- The home-screen widget: the song playing, with previous / play-pause / next (see PlayerWidgetProvider). -->
    <receiver
      android:name="expo.modules.selfhostnative.PlayerWidgetProvider"
      android:exported="false"
      android:label="SelfHost Hub">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/player_widget_info" />
    </receiver>
  </application>
</manifest>
