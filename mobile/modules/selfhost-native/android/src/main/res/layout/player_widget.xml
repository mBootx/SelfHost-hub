<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SelfHost Hub"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3B3B3"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/selfhost_widget_previous"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/selfhost_widget_toggle"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/selfhost_widget_next"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
